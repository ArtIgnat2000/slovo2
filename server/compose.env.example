# Скопируйте в compose.env и заполните. Файл не коммитится.
#
# Токен администратора: только он может создавать классы и смотреть метрики.
# Сгенерировать: openssl rand -base64 32
ADMIN_TOKEN=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_ТОКЕН_НЕ_КОРОЧЕ_24_СИМВОЛОВ
#
# Откуда браузеру разрешено обращаться к API (через запятую, без пробелов).
# Для GitHub Pages: https://artignat2000.github.io
# Для локальной разработки: http://localhost:5173
ALLOWED_ORIGINS=https://artignat2000.github.io,http://localhost:5173
