{
  "name": "slovo2",
  "version": "0.82.0",
  "private": true,
  "description": "СЛОВО 2.0 — словарные слова 1–4 класса. Mobile-first офлайн PWA.",
  "type": "module",
  "scripts": {
    "pickup": "node scripts/pickup.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:build": "VITE_BASE=/ vite build --outDir preview",
    "preview:show": "python3 scripts/preview_server.py --port 8080 --directory preview",
    "typecheck": "tsc --noEmit",
    "release:check": "node scripts/release-check.mjs",
    "test:release": "node --test tests/release-check.test.mjs",
    "content:check": "node scripts/check-content.mjs",
    "test:content": "node scripts/content-test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:guard": "node scripts/purchase-guard.mjs",
    "test:icons": "node scripts/icons-check.mjs",
    "test:contrast": "node scripts/contrast-check.mjs",
    "test:boot": "node scripts/prod-boot-check.mjs",
    "audit:storage": "node scripts/audit-storage.mjs",
    "images": "node scripts/make-word-images.mjs",
    "images:report": "node scripts/image-coverage.mjs",
    "chests:art": "node scripts/process-chest-art.mjs",
    "cars:art": "node scripts/make-car-images.mjs",
    "promo": "OUT_DIR=docs/promo/$(date +%F) node scripts/promo/make_costumes.mjs",
    "test:adaptive": "node scripts/adaptive-test.mjs",
    "test:qr": "node scripts/qr-verify.mjs",
    "demo:check": "node scripts/demo-render-check.mjs",
    "merch:art": "node scripts/make-merch-art.mjs all",
    "naash:art": "node scripts/make-naash-gallery.mjs",
    "merch:preview": "node scripts/merch-preview.mjs 4173",
    "audio:check": "node scripts/check-audio.mjs",
    "music:fetch": "node scripts/fetch-music.mjs",
    "server:start": "node --disable-warning=ExperimentalWarning server/src/main.mjs",
    "server:test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.mjs",
    "server:backup": "node --disable-warning=ExperimentalWarning server/scripts/backup.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
